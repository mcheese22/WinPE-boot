<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================
   autounattend.xml  --  automated DUAL-BOOT Windows 11 install
  =====================================================================
  Put this file in the ROOT of your Rufus Windows 11 USB (next to
  setup.exe / the "sources" folder). When you boot the USB, Windows
  Setup finds it automatically and runs the whole install hands-free.

  WHAT IT DOES, in order:
    1. (windowsPE pass) Runs diskpart to:
         - select your existing disk + volume
         - SHRINK that volume by a set size (non-destructive)
         - CREATE a new partition in the freed space
         - FORMAT it and give it a drive letter
    2. Installs Windows 11 INTO that new partition only.
       Your existing Windows 11 is left completely alone -> dual boot.

  CURRENT VALUES (from your setup):
      A. Disk    = 0
      B. Volume  = 0   (shrunk)
      C. Shrink  = 40960 MB  (= 40 GB freed)
      D. InstallTo PartitionID = 3   <-- ***MUST VERIFY, see DANGER ZONE***
      E. Edition = Windows 11 Home
      F. Account = none preset (you create it at the end)

  !!! SAFETY !!!
    - The shrink is non-destructive (only reclaims free space).
    - The DANGER is the InstallTo PartitionID (item D): if it points at
      an EXISTING partition (very likely your current Windows on a normal
      laptop), Setup will FORMAT and ERASE it. Verify it is the NEW ~40 GB
      partition before trusting it.
    - TEST IN A VIRTUAL MACHINE FIRST. It's free and it cannot hurt your
      real laptop. See docs/DUALBOOT.md.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- =================================================================
       PASS 1: windowsPE  (partitioning + which image to install)
       ================================================================= -->
  <settings pass="windowsPE">

    <!-- Language / keyboard so Setup never stops to ask -->
    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral"
               versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral"
               versionScope="nonSxS">

      <!-- ---------------------------------------------------------------
           STEP 1: shrink existing volume + create the new partition.
           The commands are piped straight into diskpart (no external
           script file needed, so USB drive-letter doesn't matter).

           ### SET ### the three numbers below:
             SELECT DISK=0        -> (A) target disk
             SELECT VOLUME=2      -> (B) volume to shrink (your C:)
             SHRINK DESIRED=61440 -> (C) size to free, in MB (here 60 GB)

           NOTE: volume NUMBERS inside Setup can differ from what you see
           in normal Windows. Confirm them with "list volume" from a
           Setup command prompt (Shift+F10) or a VM test first.
           --------------------------------------------------------------- -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Shrink volume and create dual-boot partition</Description>
          <Path>cmd.exe /c "(echo SELECT DISK=0 &amp; echo SELECT VOLUME=0 &amp; echo SHRINK DESIRED=40960 &amp; echo CREATE PARTITION PRIMARY &amp; echo FORMAT FS=NTFS LABEL=Windows11 QUICK &amp; echo ASSIGN LETTER=W) | diskpart.exe"</Path>
        </RunSynchronousCommand>
      </RunSynchronous>

      <UserData>
        <!-- Generic Windows 11 HOME key: lets Setup proceed WITHOUT asking.
             It does NOT activate Windows (use your own key later, or
             replace this with your real key). -->
        <ProductKey>
          <Key>TX9XD-98N7V-6WMQ6-BX7FG-H8Q99</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
      </UserData>

      <ImageInstall>
        <OSImage>
          <!-- ### SET ### edition name that EXISTS in your ISO.
               Check with:  dism /Get-WimInfo /WimFile:X:\sources\install.wim
               Common values: "Windows 11 Home", "Windows 11 Pro". -->
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Home</Value>
            </MetaData>
          </InstallFrom>

          <!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
               DANGER ZONE - install target partition.
               You said "partition 3". This MUST be the brand-NEW empty
               partition created by the shrink above, NOT your existing
               Windows partition.

               On many Windows 11 laptops your CURRENT Windows is ALREADY
               partition 3 (Recovery=1, EFI=2, MSR sometimes hidden,
               Windows=3/4). If partition 3 is your current Windows, this
               will FORMAT AND ERASE IT.

               CONFIRM before using: at the first Setup screen press
               Shift+F10, then:
                   diskpart
                   select disk 0
                   list partition
               The new partition is the one whose size ~= 40 GB that did
               NOT exist before. Put ITS number here.
               !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>
    </component>
  </settings>

  <!-- =================================================================
       PASS 2: specialize  (skip a couple of prompts)
       ================================================================= -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral"
               versionScope="nonSxS">
      <ComputerName>*</ComputerName>
    </component>
  </settings>

  <!-- =================================================================
       PASS 3: oobeSystem  (skip the out-of-box setup, make an account)
       ================================================================= -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral"
               versionScope="nonSxS">

      <!-- No preset account: the shrink + install run hands-free, and at
           the very end you create your own account on the normal Windows
           welcome screens. (HideOnlineAccountScreens left FALSE so the
           account screen is shown for you to fill in.) -->
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>false</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
    </component>
  </settings>

</unattend>
